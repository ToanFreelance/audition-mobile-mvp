{
  "name": "audition-mobile-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/analyze-rhythm.mjs",
    "build": "next build",
    "prebuild": "node scripts/analyze-rhythm.mjs",
    "start": "next start",
    "lint": "next lint",
    "test:qa": "playwright test",
    "test:qa:ui": "playwright test --ui",
    "test:qa:report": "playwright show-report",
    "test:qa:core": "playwright test --project=desktop --workers=1 --grep-invert @real",
    "test:qa:lobby:e2e": "playwright test e2e/lobby-real-user.spec.ts --project=desktop --project=mobile --workers=1 --grep @real",
    "test:qa:lobby:fast": "playwright test e2e/lobby-preload-handoff.spec.ts e2e/lobby-all-clients-loaded.spec.ts e2e/lobby-start-freeze.spec.ts e2e/lobby-presence.spec.ts e2e/lobby-stage-identity.spec.ts e2e/multiplayer-start-protocol.spec.ts e2e/multiplayer-transport.spec.ts --project=desktop --workers=1"
  },
  "dependencies": {
    "@audio/beat": "^2.1.3",
    "essentia.js": "^0.1.3",
    "music-tempo": "^1.0.3",
    "next": "16.3.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "wavesurfer.js": "^7.12.11",
    "web-audio-beat-detector": "^8.2.39"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.15.21",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/three": "0.180.0",
    "@tailwindcss/postcss": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "typescript": "5.8.3"
  }
}
